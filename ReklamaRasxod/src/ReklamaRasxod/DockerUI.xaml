<UserControl x:Class="ReklamaRasxod.DockerUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="270"
             FontFamily="Segoe UI"
             FontSize="12"
             Unloaded="DockerUI_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource PanelBrush}">

        <!-- Sarlavha -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="12,8">
            <StackPanel>
                <TextBlock Text="REKLAMA RASXOD" Foreground="White" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Dizayn bo'yicha material rasxodi va smeta: akril, fomaks, diod, blok, temir, kraska..."
                           Foreground="#D7F2E4" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Pastda: jami summa va eksport -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="8,6,8,8">
            <StackPanel>
                <Border Background="{StaticResource TotalBackBrush}" CornerRadius="4" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="JAMI" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource AccentDarkBrush}"/>
                        <TextBlock x:Name="GrandTotalText" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource AccentDarkBrush}" Text="0"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="TotalsBreakdownText" Style="{StaticResource Hint}" Margin="2,3,2,0"/>
                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <Button x:Name="CsvButton" Style="{StaticResource SecondaryButton}" Margin="0,0,3,0"
                            Content="Excel (CSV) saqlash" Click="CsvButton_Click"/>
                    <Button x:Name="CorelTableButton" Style="{StaticResource PrimaryButton}" Margin="3,0,0,0" Padding="6,6"
                            Content="COREL'GA SMETA" Click="CorelTableButton_Click"/>
                </UniformGrid>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="2,4,2,0"/>
            </StackPanel>
        </Border>

        <!-- Dizayn ko'rinishi: doim yuqorida -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="8,8,8,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="DayRadio" Style="{StaticResource Segment}" Content="Kunduzi" IsChecked="True"
                                 GroupName="PreviewMode" Checked="Setting_Changed"/>
                    <RadioButton x:Name="NightRadio" Style="{StaticResource Segment}" Content="Kechasi"
                                 GroupName="PreviewMode" Checked="Setting_Changed"/>
                </StackPanel>
                <Border x:Name="PreviewHost" Height="160" CornerRadius="4" Padding="8" Background="{StaticResource CheckerBrush}">
                    <Viewbox x:Name="PreviewBox" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="SizeInfoText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                <Border x:Name="WarningBox" Style="{StaticResource WarningBox}" Visibility="Collapsed">
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}" FontSize="11.5"/>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">

                <!-- 1. Logo -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="1. LOGO"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" Background="{StaticResource CheckerBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Image x:Name="LogoImage" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LogoInfoText" Text="Logo tanlanmagan" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}"/>
                                <Button x:Name="CaptureButton" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0"
                                        Content="Tanlangan logoni olish" Click="CaptureButton_Click"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="ImportButton" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0"
                                Content="Reklama Maket'dagi oxirgi dizaynni olish" Click="ImportButton_Click"/>
                        <TextBlock x:Name="ImportInfoText" Style="{StaticResource Hint}" Margin="0,0,0,2"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Bo'yi"/>
                            <TextBox x:Name="LogoHeightBox" Grid.Column="1" TextChanged="LogoHeight_Changed"/>
                            <TextBlock x:Name="LogoHeightUnit" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Eni"/>
                            <TextBox x:Name="LogoWidthBox" Grid.Row="1" Grid.Column="1" TextChanged="LogoWidth_Changed"/>
                            <TextBlock x:Name="LogoWidthUnit" Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Birlik"/>
                            <ComboBox x:Name="UnitCombo" Grid.Row="2" Grid.Column="1" SelectionChanged="UnitCombo_SelectionChanged"/>
                        </Grid>
                        <TextBlock x:Name="MeasureText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2. Logo dizayni -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="2. LOGO DIZAYNI (HARF YOKI O'YIQ)"/>
                        <ComboBox x:Name="LetterCombo" SelectionChanged="LetterCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding EnglishName}" FontSize="10.5" Foreground="#69717C"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10.5" Foreground="#178A55"
                                                       Margin="4,6,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                        <TextBlock x:Name="LetterDescription" Style="{StaticResource Hint}" Margin="0,4,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DepthLabel" Style="{StaticResource FieldLabel}" Text="Qalinligi"/>
                            <TextBox x:Name="DepthBox" Grid.Column="1" TextChanged="Setting_Changed"/>
                            <TextBlock x:Name="DepthUnit" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="44"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="FaceColorLabel" Style="{StaticResource FieldLabel}" Text="Yuz"/>
                            <Button x:Name="FaceButton" Grid.Column="1" Tag="Face" Style="{StaticResource Swatch}" Width="28"
                                    Margin="0,2,6,2" ToolTip="Yuz rangi (oq bo'lmasa — orakal hisoblanadi)" Click="ColorButton_Click"/>
                            <TextBox x:Name="FaceHex" Grid.Column="2" Tag="Face" HorizontalContentAlignment="Left" TextChanged="Hex_TextChanged"/>

                            <TextBlock x:Name="ReturnColorLabel" Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Bort"/>
                            <Button x:Name="ReturnButton" Grid.Row="1" Grid.Column="1" Tag="Return" Style="{StaticResource Swatch}" Width="28"
                                    Margin="0,2,6,2" ToolTip="Bort (yon tomoni) rangi" Click="ColorButton_Click"/>
                            <TextBox x:Name="ReturnHex" Grid.Row="1" Grid.Column="2" Tag="Return" HorizontalContentAlignment="Left" TextChanged="Hex_TextChanged"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Nur"/>
                            <Button x:Name="LightButton" Grid.Row="2" Grid.Column="1" Tag="Light" Style="{StaticResource Swatch}" Width="28"
                                    Margin="0,2,6,2" ToolTip="LED nuri rangi" Click="ColorButton_Click"/>
                            <TextBox x:Name="LightHex" Grid.Row="2" Grid.Column="2" Tag="Light" HorizontalContentAlignment="Left" TextChanged="Hex_TextChanged"/>
                        </Grid>

                        <CheckBox x:Name="KeepColorsCheck" Content="Yuzda logoning o'z ranglari (orakal bilan)" Margin="0,6,0,0"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </StackPanel>
                </Border>

                <!-- 3. Fon dizayni -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="3. FON DIZAYNI"/>
                        <ComboBox x:Name="BackgroundCombo" SelectionChanged="BackgroundCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding EnglishName}" FontSize="10.5" Foreground="#69717C"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="BackgroundDescription" Style="{StaticResource Hint}" Margin="0,4,0,8"/>

                        <StackPanel x:Name="PatternPanel" Visibility="Collapsed" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Gul (naqsh)"/>
                            <ComboBox x:Name="PatternCombo" MaxDropDownHeight="420" SelectionChanged="PatternCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Border Width="48" Height="32" BorderBrush="#DDE1E7" BorderThickness="1" ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding EnglishName}" FontSize="10.5" Foreground="#69717C"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="LightingPanel" Visibility="Collapsed" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Fon yoritilishi (qaysi joyi yonadi)"/>
                            <ComboBox x:Name="BackgroundLightCombo" DisplayMemberPath="Name" SelectionChanged="Setting_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Yonsa: orqa quti, nur tarqatgich va LED hisoblanadi. Fon qalinligi kamida 4 sm."/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Rangi"/>
                            <Button x:Name="BackgroundButton" Grid.Column="1" Tag="Background" Style="{StaticResource Swatch}" Width="28"
                                    Margin="0,2,6,2" ToolTip="Fon rangi" Click="ColorButton_Click"/>
                            <TextBox x:Name="BackgroundHex" Grid.Column="2" Tag="Background" HorizontalContentAlignment="Left" TextChanged="Hex_TextChanged"/>
                        </Grid>

                        <CheckBox x:Name="EngravedBorderCheck" Content="Chetida o'yilgan ramka chizig'i (gravirovka)" Margin="0,6,0,0"
                                  Visibility="Collapsed" Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                        <CheckBox x:Name="AutoSizeCheck" IsChecked="True" Content="Avtomatik o'lcham (logo + chetdan joy)" Margin="0,6,0,2"
                                  Checked="AutoSize_Changed" Unchecked="AutoSize_Changed"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Fon eni"/>
                            <TextBox x:Name="BackgroundWidthBox" Grid.Column="1" IsEnabled="False" TextChanged="Setting_Changed"/>
                            <TextBlock x:Name="BackgroundWidthUnit" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Fon bo'yi"/>
                            <TextBox x:Name="BackgroundHeightBox" Grid.Row="1" Grid.Column="1" IsEnabled="False" TextChanged="Setting_Changed"/>
                            <TextBlock x:Name="BackgroundHeightUnit" Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Chetdan joy"/>
                            <TextBox x:Name="MarginBox" Grid.Row="2" Grid.Column="1" TextChanged="Setting_Changed"/>
                            <TextBlock x:Name="MarginUnit" Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Fon qalinligi"/>
                            <TextBox x:Name="BackgroundDepthBox" Grid.Row="3" Grid.Column="1" TextChanged="Setting_Changed"/>
                            <TextBlock x:Name="BackgroundDepthUnit" Grid.Row="3" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Joylashuvi"/>
                            <ComboBox x:Name="AlignCombo" Grid.Row="4" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="Setting_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Detallar (ro'yxat dizaynga qarab koddan quriladi) -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="4. DETALLAR: RANG VA O'LCHAM"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                   Text="Distansiya, LED nuqta, ramka, gul, reyka... rasxodga ta'sir qiladi. Bo'sh — dizaynning o'z qiymati."/>
                        <StackPanel x:Name="DetailsPanel"/>
                    </StackPanel>
                </Border>

                <!-- 5. Konstruksiya -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="5. KONSTRUKSIYA (NIMADAN YASALADI)"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Harf borti"/>
                            <ComboBox x:Name="ReturnsCombo" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="Construction_Changed"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Harf orqasi"/>
                            <ComboBox x:Name="BackCombo" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="Construction_Changed"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Fomaks"/>
                            <ComboBox x:Name="FomaxCombo" Grid.Row="2" Grid.Column="1" ItemStringFormat="{}{0} mm" SelectionChanged="Construction_Changed"/>

                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Alyukobond"/>
                            <ComboBox x:Name="AcpCombo" Grid.Row="3" Grid.Column="1" ItemStringFormat="{}{0} mm" SelectionChanged="Construction_Changed"/>

                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Karkas profili"/>
                            <ComboBox x:Name="ProfileCombo" Grid.Row="4" Grid.Column="1" SelectionChanged="Construction_Changed"/>

                            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Listlar"/>
                            <ComboBox x:Name="SheetUnitCombo" Grid.Row="5" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="Construction_Changed"/>
                        </Grid>
                        <CheckBox x:Name="PaintReturnsCheck" Content="Harf bortini bo'yash (alyuminiy / fomaks)" Margin="0,6,0,0"
                                  Checked="Construction_Changed" Unchecked="Construction_Changed"/>
                        <TextBlock x:Name="ConstructionText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 6. Rasxod -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="6. RASXOD (MATERIALLAR) VA NARX"/>
                            <Button x:Name="ResetQuantitiesButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="6,1" Margin="0,0,0,4"
                                    Content="↺ Miqdorlar" FontSize="11" ToolTip="Qo'lda o'zgartirilgan miqdorlarni hisoblanganiga qaytarish"
                                    Click="ResetQuantitiesButton_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,2"
                                   Text="Narxni bir marta kiriting — keyingi hisoblarda eslab qoladi. Miqdorni ham qo'lda o'zgartirish mumkin (0 — hisobga kirmaydi)."/>
                        <TextBlock x:Name="NotesText" Style="{StaticResource Hint}" Foreground="{StaticResource WarningTextBrush}" Margin="0,2,0,0"/>
                        <StackPanel x:Name="MaterialsPanel"/>

                        <TextBlock Style="{StaticResource GroupTitle}" Text="QO'SHIMCHA XARAJATLAR (ISH HAQI, MONTAJ, TRANSPORT...)"/>
                        <StackPanel x:Name="CustomPanel"/>
                        <Button x:Name="AddRowButton" Style="{StaticResource SecondaryButton}" Content="+ Qator qo'shish" Click="AddRowButton_Click"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ustama (foyda)"/>
                            <TextBox x:Name="MarkupBox" Grid.Column="1" TextChanged="MarkupBox_TextChanged"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center" Text="%"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Valyuta"/>
                            <TextBox x:Name="CurrencyBox" Grid.Row="1" Grid.Column="1" HorizontalContentAlignment="Left" TextChanged="CurrencyBox_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 7. Normalar -->
                <Border Style="{StaticResource Card}">
                    <Expander Header="7. SARF NORMALARI (CHIQINDI, LIST O'LCHAMI, LED, BLOK...)" Foreground="{StaticResource MutedBrush}" FontSize="11">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="Hisob shu normalar bo'yicha. O'zgartirilgan qiymat saqlanib qoladi."/>
                            <StackPanel x:Name="NormsPanel"/>
                            <Button x:Name="ResetNormsButton" Style="{StaticResource SecondaryButton}" Content="Standart normalarga qaytarish"
                                    Click="ResetNormsButton_Click"/>
                        </StackPanel>
                    </Expander>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
