# --- Asosiy ---
# Saytning to'liq manzili (oxirida / yo'q)
SITE_URL=https://pp-design.duckdns.org
# PostgreSQL ulanishi
DATABASE_URL=postgresql://ppdesign:PAROL@localhost:5432/ppdesign
# Sessiya uchun maxfiy kalit (kamida 32 belgi): openssl rand -hex 32
SESSION_SECRET=
# Yuklangan rasmlar saqlanadigan papka
UPLOAD_DIR=./uploads

# --- Telegram bot ---
# @BotFather bergan token
TELEGRAM_BOT_TOKEN=
# Bot username (@ belgisiz), masalan: ppdesign_bot
TELEGRAM_BOT_USERNAME=
# Admin(lar) Telegram ID — vergul bilan. Bu ID'lar: bildirishnoma oladi, botda tasdiqlay oladi, saytga admin bo'lib kiradi
TELEGRAM_ADMIN_IDS=
# Webhook maxfiy kaliti (ixtiyoriy so'z, faqat harf/raqam/_/-): openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=

# --- Admin parol bilan kirish (zaxira yo'l) ---
ADMIN_PASSWORD=

# --- SMS (Eskiz.uz) ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Eskiz'dagi jo'natuvchi nomi (default: 4546)
ESKIZ_FROM=4546
# SMS matni. Eskiz'da tasdiqlangan shablon bilan BIR XIL bo'lishi kerak. {code} o'rniga kod qo'yiladi
SMS_TEMPLATE=PP Design saytiga kirish kodi: {code}

# --- Faqat lokal sinov uchun (productionda yoqmang!) ---
# 1 bo'lsa: SMS yuborilmaydi, kod ekranda ko'rinadi va /login sahifasida "test kirish" tugmalari chiqadi
DEV_LOGIN=0
