<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ReklamaMaket</RootNamespace>
    <AssemblyName>ReklamaMaket</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.1.0</Version>
    <Product>Reklama Maket</Product>
    <Description>CorelDRAW uchun tashqi reklama maketi paneli</Description>
  </PropertyGroup>

  <!--
    CorelDRAW o'rnatilgan papka (Programs64). build.bat uni avtomatik topadi va
    CorelPath.local.props fayliga yozib qo'yadi (keyin Visual Studio ham shu yo'ldan foydalanadi).
    Qo'lda: dotnet build -p:CorelPath="C:\Program Files\Corel\CorelDRAW Graphics Suite 2021\Programs64"
  -->
  <Import Project="CorelPath.local.props" Condition="Exists('CorelPath.local.props')" />
  <PropertyGroup>
    <CorelPath Condition="'$(CorelPath)' == ''">C:\Program Files\Corel\CorelDRAW Graphics Suite 2021\Programs64\</CorelPath>
    <CorelPath Condition="!HasTrailingSlash('$(CorelPath)')">$(CorelPath)\</CorelPath>
    <VGCorePath Condition="'$(VGCorePath)' == ''">$(CorelPath)Assemblies\Corel.Interop.VGCore.dll</VGCorePath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Corel.Interop.VGCore">
      <HintPath>$(VGCorePath)</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- ChatGPT (OpenAI API): HTTP, JSON va API kalitni shifrlash -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Visual Studio'siz (faqat dotnet SDK bilan) ham yig'ilishi uchun -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- CorelDRAW paneli shu fayllar orqali ro'yxatdan o'tadi -->
    <None Update="AppUI.xslt;UserUI.xslt;CorelDrw.addon" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckCorelInterop" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(VGCorePath)')">
    <Error Text="Corel.Interop.VGCore.dll topilmadi: $(VGCorePath)&#10;build.bat ni ishga tushiring yoki CorelPath ni ko'rsating, masalan:&#10;dotnet build -p:CorelPath=&quot;C:\Program Files\Corel\CorelDRAW Graphics Suite 2021\Programs64&quot;" />
  </Target>

</Project>
