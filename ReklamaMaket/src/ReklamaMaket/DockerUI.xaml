<UserControl x:Class="ReklamaMaket.DockerUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="270"
             FontFamily="Segoe UI"
             FontSize="12"
             Unloaded="DockerUI_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource PanelBrush}">

        <!-- Sarlavha -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="12,8">
            <StackPanel>
                <TextBlock Text="REKLAMA MAKET" Foreground="White" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Hajmli harflar (Channel letters): dizayn, o'lcham va ChatGPT bilan real ko'rinish"
                           Foreground="#D6E4FF" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Pastki tugma -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="8,6,8,8">
            <StackPanel>
                <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}"
                        Content="CORELDA DIZAYN CHIZISH" Click="CreateButton_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="2,4,2,0"/>
            </StackPanel>
        </Border>

        <!-- Ko'rinish: doim yuqorida -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="8,8,8,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="DayRadio" Style="{StaticResource Segment}" Content="Kunduzi" IsChecked="True"
                                 GroupName="PreviewMode" Checked="Setting_Changed"/>
                    <RadioButton x:Name="NightRadio" Style="{StaticResource Segment}" Content="Kechasi"
                                 GroupName="PreviewMode" Checked="Setting_Changed"/>
                </StackPanel>
                <Border x:Name="PreviewHost" Height="200" CornerRadius="4" Padding="8" Background="{StaticResource CheckerBrush}">
                    <Viewbox x:Name="PreviewBox" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="SizeInfoText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                <Border x:Name="WarningBox" Style="{StaticResource WarningBox}" Visibility="Collapsed">
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}" FontSize="11.5"/>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">

                <!-- 1. Logo -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="1. LOGO"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" Background="{StaticResource CheckerBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Image x:Name="LogoImage" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LogoInfoText" Text="Logo tanlanmagan" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}"/>
                                <Button x:Name="CaptureButton" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0"
                                        Content="Tanlangan logoni olish" Click="CaptureButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Bo'yi"/>
                            <TextBox x:Name="LogoHeightBox" Grid.Column="1" TextChanged="LogoHeight_Changed"/>
                            <TextBlock x:Name="LogoHeightUnit" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Eni"/>
                            <TextBox x:Name="LogoWidthBox" Grid.Row="1" Grid.Column="1" TextChanged="LogoWidth_Changed"/>
                            <TextBlock x:Name="LogoWidthUnit" Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Birlik"/>
                            <ComboBox x:Name="UnitCombo" Grid.Row="2" Grid.Column="1" SelectionChanged="UnitCombo_SelectionChanged"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Eni va bo'yi logo proporsiyasi bo'yicha bog'langan. Asl logo o'zgarmaydi."/>
                    </StackPanel>
                </Border>

                <!-- 2. Harf (logo) dizayni -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="2. LOGO DIZAYNI (HARF YOKI O'YIQ)"/>
                        <ComboBox x:Name="LetterCombo" SelectionChanged="LetterCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding EnglishName}" FontSize="10.5" Foreground="#69717C"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10.5" Foreground="#2F6FDE"
                                                       Margin="4,6,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                        <TextBlock x:Name="LetterDescription" Style="{StaticResource Hint}" Margin="0,4,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DepthLabel" Style="{StaticResource FieldLabel}" Text="Qalinligi"/>
                            <TextBox x:Name="DepthBox" Grid.Column="1" TextChanged="Setting_Changed"/>
                            <TextBlock x:Name="DepthUnit" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="44"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="FaceColorLabel" Style="{StaticResource FieldLabel}" Text="Yuz"/>
                            <Button x:Name="FaceButton" Grid.Column="1" Tag="Face" Style="{StaticResource Swatch}" Width="28"
                                    Margin="0,2,6,2" ToolTip="Yuz rangi" Click="ColorButton_Click"/>
                            <TextBox x:Name="FaceHex" Grid.Column="2" Tag="Face" HorizontalContentAlignment="Left" TextChanged="Hex_TextChanged"/>

                            <TextBlock x:Name="ReturnColorLabel" Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Bort"/>
                            <Button x:Name="ReturnButton" Grid.Row="1" Grid.Column="1" Tag="Return" Style="{StaticResource Swatch}" Width="28"
                                    Margin="0,2,6,2" ToolTip="Bort (yon tomoni) rangi" Click="ColorButton_Click"/>
                            <TextBox x:Name="ReturnHex" Grid.Row="1" Grid.Column="2" Tag="Return" HorizontalContentAlignment="Left" TextChanged="Hex_TextChanged"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Nur"/>
                            <Button x:Name="LightButton" Grid.Row="2" Grid.Column="1" Tag="Light" Style="{StaticResource Swatch}" Width="28"
                                    Margin="0,2,6,2" ToolTip="LED nuri rangi" Click="ColorButton_Click"/>
                            <TextBox x:Name="LightHex" Grid.Row="2" Grid.Column="2" Tag="Light" HorizontalContentAlignment="Left" TextChanged="Hex_TextChanged"/>

                            <WrapPanel x:Name="LightSwatches" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"/>
                        </Grid>

                        <CheckBox x:Name="KeepColorsCheck" Content="Yuzda logoning o'z ranglari" Margin="0,6,0,0"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </StackPanel>
                </Border>

                <!-- 3. Fon dizayni -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="3. FON DIZAYNI"/>
                        <ComboBox x:Name="BackgroundCombo" SelectionChanged="BackgroundCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding EnglishName}" FontSize="10.5" Foreground="#69717C"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="BackgroundDescription" Style="{StaticResource Hint}" Margin="0,4,0,8"/>

                        <StackPanel x:Name="PatternPanel" Visibility="Collapsed" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Gul (naqsh)"/>
                            <ComboBox x:Name="PatternCombo" MaxDropDownHeight="420" SelectionChanged="Setting_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Border Width="48" Height="32" BorderBrush="#DDE1E7" BorderThickness="1" ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding EnglishName}" FontSize="10.5" Foreground="#69717C"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="LightingPanel" Visibility="Collapsed" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Fon yoritilishi (qaysi joyi yonadi)"/>
                            <ComboBox x:Name="BackgroundLightCombo" DisplayMemberPath="Name" SelectionChanged="Setting_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Nur rangi — harf dizaynidagi «Nur» rangi. Yonishi uchun fon qalinligi kamida 4 sm."/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Rangi"/>
                            <Button x:Name="BackgroundButton" Grid.Column="1" Tag="Background" Style="{StaticResource Swatch}" Width="28"
                                    Margin="0,2,6,2" ToolTip="Fon rangi" Click="ColorButton_Click"/>
                            <TextBox x:Name="BackgroundHex" Grid.Column="2" Tag="Background" HorizontalContentAlignment="Left" TextChanged="Hex_TextChanged"/>
                            <WrapPanel x:Name="BackgroundSwatches" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0"/>
                        </Grid>

                        <CheckBox x:Name="EngravedBorderCheck" Content="Chetida o'yilgan ramka chizig'i (gravirovka)" Margin="0,6,0,0"
                                  Visibility="Collapsed" Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                        <CheckBox x:Name="AutoSizeCheck" IsChecked="True" Content="Avtomatik o'lcham (logo + chetdan joy)" Margin="0,6,0,2"
                                  Checked="AutoSize_Changed" Unchecked="AutoSize_Changed"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Fon eni"/>
                            <TextBox x:Name="BackgroundWidthBox" Grid.Column="1" IsEnabled="False" TextChanged="Setting_Changed"/>
                            <TextBlock x:Name="BackgroundWidthUnit" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Fon bo'yi"/>
                            <TextBox x:Name="BackgroundHeightBox" Grid.Row="1" Grid.Column="1" IsEnabled="False" TextChanged="Setting_Changed"/>
                            <TextBlock x:Name="BackgroundHeightUnit" Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Chetdan joy"/>
                            <TextBox x:Name="MarginBox" Grid.Row="2" Grid.Column="1" TextChanged="Setting_Changed"/>
                            <TextBlock x:Name="MarginUnit" Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Fon qalinligi"/>
                            <TextBox x:Name="BackgroundDepthBox" Grid.Row="3" Grid.Column="1" TextChanged="Setting_Changed"/>
                            <TextBlock x:Name="BackgroundDepthUnit" Grid.Row="3" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Joylashuvi"/>
                            <ComboBox x:Name="AlignCombo" Grid.Row="4" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="Setting_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Corel -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="4. COREL CHIZMASI"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Masshtab"/>
                            <ComboBox x:Name="ScaleCombo" Grid.Column="1" ItemStringFormat="1:{0}" SelectionChanged="Setting_Changed"/>
                        </Grid>
                        <CheckBox x:Name="NightCheck" IsChecked="True" Content="Kechki ko'rinish" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="SectionCheck" IsChecked="True" Content="Yon kesim (sxema)" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="DimensionsCheck" IsChecked="True" Content="O'lcham chiziqlari" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="NewPageCheck" IsChecked="True" Content="Yangi sahifada" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </StackPanel>
                </Border>

                <!-- 5. ChatGPT -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="5. CHATGPT — REAL KO'RINISH"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                   Text="Har kim o'z OpenAI API kalitini ulaydi. Kalit shu kompyuterda shifrlangan holda saqlanadi."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox" Padding="4,3" Margin="0,2,6,2" VerticalContentAlignment="Center"/>
                            <Button x:Name="SaveKeyButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="8,3"
                                    Content="Saqlash" Click="SaveKeyButton_Click"/>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink x:Name="ApiKeyLink" RequestNavigate="Link_RequestNavigate">API kalit olish →</Hyperlink>
                            </TextBlock>
                            <Button x:Name="CheckKeyButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="8,3"
                                    Content="Tekshirish" Click="CheckKeyButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="KeyStatusText" Style="{StaticResource Hint}" Margin="0,2,0,6"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Dizayn manbai"/>
                        <RadioButton x:Name="SourceLastRadio" Content="Oxirgi chizilgan dizayn (avtomatik)" IsChecked="True" Margin="0,3" Checked="Setting_Changed"/>
                        <RadioButton x:Name="SourceSelectionRadio" Content="Corelda tanlangan obyekt" Margin="0,3" Checked="Setting_Changed"/>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Joy rasmi (bino fasadi, ixtiyoriy)" Margin="0,6,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PickPhotoButton" Style="{StaticResource SecondaryButton}" Padding="8,3"
                                    Content="Rasm tanlash..." Click="PickPhotoButton_Click"/>
                            <TextBlock x:Name="PhotoText" Grid.Column="1" Style="{StaticResource Hint}" Margin="6,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="tanlanmagan"/>
                            <Button x:Name="ClearPhotoButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="8,3"
                                    Content="×" ToolTip="Rasmni olib tashlash" Click="ClearPhotoButton_Click"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="So'rov (prompt)"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="6,1" Margin="0"
                                    Content="Standart" FontSize="11" Click="ResetPromptButton_Click"/>
                        </Grid>
                        <TextBox x:Name="PromptBox" Height="88" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="Setting_Changed"
                                 VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                   Text="Plagin dizayni tavsifi (harf, fon, gul, ranglar, yoritilish, o'lcham) so'rovga avtomatik qo'shiladi."/>
                        <Expander Header="Yuboriladigan to'liq so'rovni ko'rish" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}">
                            <TextBox x:Name="FullPromptBox" IsReadOnly="True" TextWrapping="Wrap" Height="180" FontSize="11"
                                     VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top"/>
                        </Expander>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox x:Name="AiDayCheck" Content="Kunduzi" IsChecked="True" Margin="0,0,14,0"/>
                            <CheckBox x:Name="AiNightCheck" Content="Kechasi" IsChecked="True"/>
                        </StackPanel>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Model"/>
                            <ComboBox x:Name="ModelCombo" Grid.Column="1" IsEditable="True"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Sifat"/>
                            <ComboBox x:Name="QualityCombo" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Rasm o'lchami"/>
                            <ComboBox x:Name="SizeCombo" Grid.Row="2" Grid.Column="1"/>
                        </Grid>

                        <CheckBox x:Name="AutoSendCheck" Content="Dizayn chizilgach avtomatik yuborish" Margin="0,6,0,2"/>

                        <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0"
                                Content="CHATGPT: REAL KO'RINISH" Click="GenerateButton_Click"/>
                        <Button x:Name="CancelAiButton" Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                Content="Bekor qilish" Click="CancelAiButton_Click"/>
                        <ProgressBar x:Name="AiProgress" Height="4" Margin="0,4,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                        <TextBlock x:Name="AiStatusText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>

                        <UniformGrid x:Name="AiResults" Columns="2" Margin="0,6,0,0" Visibility="Collapsed">
                            <StackPanel Margin="0,0,3,0">
                                <Border Height="90" Background="{StaticResource CheckerBrush}" CornerRadius="4">
                                    <Image x:Name="AiDayImage" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Text="Kunduzi" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="3,0,0,0">
                                <Border Height="90" Background="{StaticResource NightBrush}" CornerRadius="4">
                                    <Image x:Name="AiNightImage" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Text="Kechasi" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                        <Button x:Name="OpenFolderButton" Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                Content="Rasmlar papkasini ochish" Click="OpenFolderButton_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
