<UserControl x:Class="ReklamaMaket.DockerUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280"
             FontFamily="Segoe UI"
             FontSize="12.5"
             Unloaded="DockerUI_Unloaded"
             PreviewKeyDown="DockerUI_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBrush}">
    <DockPanel x:Name="MainView">

        <!-- Sarlavha -->
        <StackPanel DockPanel.Dock="Top" Margin="16,14,16,4">
            <TextBlock Text="CorelDRAW · tashqi reklama" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Style="{StaticResource Title}" Text="Reklama Maket"/>
            <TextBlock FontSize="12" Margin="1,1,0,0">
                <Run Text="by" Foreground="{StaticResource MutedBrush}"/>
                <Run Text="Sunnatilla Designer" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
            </TextBlock>
        </StackPanel>

        <!-- Pastki panel: sozlamalar · chizish · ChatGPT -->
        <ContentControl DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="10,4,10,10" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SettingsButton" Style="{StaticResource RoundButton}" Content="&#xE713;"
                        ToolTip="Chizma sozlamalari" Click="SettingsButton_Click"/>
                <Button x:Name="CreateButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="6,0"
                        Content="Corel'da chizish" Click="CreateButton_Click"/>
                <Button x:Name="AiQuickButton" Grid.Column="2" Style="{StaticResource RoundPrimaryButton}" Content="&#xE724;"
                        ToolTip="ChatGPT: real rasm (kunduzi va kechasi)" Click="AiQuickButton_Click"/>

                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Top"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6">
                    <ContentControl Style="{StaticResource Card}" Width="250" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Corel chizmasi" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Masshtab"/>
                                <ComboBox x:Name="ScaleCombo" Grid.Column="1" Style="{StaticResource Select}"
                                          ItemStringFormat="1:{0}" SelectionChanged="Setting_Changed"/>
                            </Grid>
                            <CheckBox x:Name="NightCheck" IsChecked="True" Content="Kechki ko'rinish" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="SectionCheck" IsChecked="True" Content="Yon kesim" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="DimensionsCheck" IsChecked="True" Content="O'lchamlar" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="NewPageCheck" IsChecked="True" Content="Yangi sahifada" Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                            <StackPanel x:Name="LicenseSection">
                                <TextBlock Text="Litsenziya" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                <TextBlock x:Name="LicenseInfoText" Style="{StaticResource Hint}"/>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Kalitni almashtirish"
                                        Click="ChangeLicense_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                </Popup>
            </Grid>
        </ContentControl>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="18,2,18,0"/>

        <!-- Ko'rinish: doim yuqorida -->
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="10,6,10,0" Padding="12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DayRadio" Style="{StaticResource Chip}" Tag="&#xE706;" Content="Kunduzi" IsChecked="True"
                                     GroupName="PreviewMode" Checked="Setting_Changed"/>
                        <RadioButton x:Name="NightRadio" Style="{StaticResource Chip}" Tag="&#xE708;" Content="Kechasi"
                                     GroupName="PreviewMode" Checked="Setting_Changed"/>
                    </StackPanel>
                    <ToggleButton x:Name="PhotoViewToggle" Grid.Column="2" Style="{StaticResource Chip}" Tag="&#xE80F;" Margin="0,0,0,6"
                                  Content="Joyida" IsEnabled="False" ToolTip="Bino rasmi ustida ko'rish"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                </Grid>
                <Border x:Name="PreviewHost" Height="190" CornerRadius="12" Padding="6" Background="{StaticResource CheckerBrush}"
                        AllowDrop="True" DragOver="Photo_DragOver" Drop="Photo_Drop"
                        MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove"
                        MouseLeftButtonUp="Preview_MouseUp" MouseWheel="Preview_MouseWheel">
                    <Viewbox x:Name="PreviewBox" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="SizeInfoText" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <Border x:Name="WarningBox" Style="{StaticResource WarningBox}" Visibility="Collapsed">
                    <TextBlock x:Name="WarningText" TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}" FontSize="11.5"/>
                </Border>
            </StackPanel>
        </ContentControl>

        <!-- Bo'limlar -->
        <WrapPanel DockPanel.Dock="Top" Margin="12,12,6,2">
            <RadioButton x:Name="TabLogo" Style="{StaticResource Chip}" Tag="&#xE8B9;" Content="Logo" GroupName="Tabs" IsChecked="True" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabLetter" Style="{StaticResource Chip}" Tag="&#xE8D2;" Content="Harf" GroupName="Tabs" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabBackground" Style="{StaticResource Chip}" Tag="&#xE80A;" Content="Fon" GroupName="Tabs" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabPhoto" Style="{StaticResource Chip}" Tag="&#xE80F;" Content="Joyida" GroupName="Tabs" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabAi" Style="{StaticResource Chip}" Tag="&#xE8BD;" Content="AI" ToolTip="ChatGPT: real rasm" GroupName="Tabs" Checked="Tab_Checked"/>
        </WrapPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,4,10,4">

                <!-- LOGO -->
                <ContentControl x:Name="LogoPage" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource CheckerBrush}">
                                <Image x:Name="LogoImage" Stretch="Uniform" Margin="6"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LogoInfoText" Text="Logo tanlanmagan" TextWrapping="Wrap"/>
                                <Button x:Name="CaptureButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                        Margin="0,6,0,0" Content="Corel'dan logoni olish" Click="CaptureButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Haqiqiy o'lchami"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Bo'yi"/>
                                <DockPanel>
                                    <TextBlock x:Name="LogoHeightUnit" DockPanel.Dock="Right" Style="{StaticResource Unit}"/>
                                    <TextBox x:Name="LogoHeightBox" TextChanged="LogoHeight_Changed"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Hint}" Text="Eni"/>
                                <DockPanel>
                                    <TextBlock x:Name="LogoWidthUnit" DockPanel.Dock="Right" Style="{StaticResource Unit}"/>
                                    <TextBox x:Name="LogoWidthBox" TextChanged="LogoWidth_Changed"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton x:Name="UnitMmRadio" Style="{StaticResource Chip}" Content="mm" GroupName="Unit" IsChecked="True" Checked="Unit_Checked"/>
                            <RadioButton x:Name="UnitCmRadio" Style="{StaticResource Chip}" Content="sm" GroupName="Unit" Checked="Unit_Checked"/>
                            <RadioButton x:Name="UnitMRadio" Style="{StaticResource Chip}" Content="m" GroupName="Unit" Checked="Unit_Checked"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>

                <!-- HARF -->
                <ContentControl x:Name="LetterPage" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="Harf turi"/>
                        <ComboBox x:Name="LetterCombo" Style="{StaticResource Select}" SelectionChanged="LetterCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5"
                                                       Foreground="{StaticResource MutedBrush}" Margin="10,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DepthLabel" Style="{StaticResource FieldLabel}" Text="Qalinligi"/>
                            <DockPanel Grid.Column="1">
                                <TextBlock x:Name="DepthUnit" DockPanel.Dock="Right" Style="{StaticResource Unit}"/>
                                <TextBox x:Name="DepthBox" TextChanged="Setting_Changed"/>
                            </DockPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Ranglar"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="FaceColorLabel" Style="{StaticResource FieldLabel}" Text="Oldi"/>
                            <Button x:Name="FaceButton" Grid.Column="1" Tag="Face" Style="{StaticResource Swatch}" Width="32" Height="32"
                                    Margin="0,3,6,3" ToolTip="Rang tanlash" Click="ColorButton_Click"/>
                            <TextBox x:Name="FaceHex" Grid.Column="2" Tag="Face" TextChanged="Hex_TextChanged"/>
                            <Button Grid.Column="3" Tag="Face" Style="{StaticResource PipetteButton}" Click="Pipette_Click"/>

                            <TextBlock x:Name="ReturnColorLabel" Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Yoni"/>
                            <Button x:Name="ReturnButton" Grid.Row="1" Grid.Column="1" Tag="Return" Style="{StaticResource Swatch}" Width="32" Height="32"
                                    Margin="0,3,6,3" ToolTip="Rang tanlash" Click="ColorButton_Click"/>
                            <TextBox x:Name="ReturnHex" Grid.Row="1" Grid.Column="2" Tag="Return" TextChanged="Hex_TextChanged"/>
                            <Button x:Name="ReturnPipette" Grid.Row="1" Grid.Column="3" Tag="Return" Style="{StaticResource PipetteButton}" Click="Pipette_Click"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Chiroq"/>
                            <Button x:Name="LightButton" Grid.Row="2" Grid.Column="1" Tag="Light" Style="{StaticResource Swatch}" Width="32" Height="32"
                                    Margin="0,3,6,3" ToolTip="Rang tanlash" Click="ColorButton_Click"/>
                            <TextBox x:Name="LightHex" Grid.Row="2" Grid.Column="2" Tag="Light" TextChanged="Hex_TextChanged"/>
                            <Button Grid.Row="2" Grid.Column="3" Tag="Light" Style="{StaticResource PipetteButton}" Click="Pipette_Click"/>

                            <WrapPanel x:Name="LightSwatches" Grid.Row="3" Grid.ColumnSpan="4" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </Grid>
                        <CheckBox x:Name="KeepColorsCheck" Content="Logoning o'z ranglari" Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                        <TextBlock x:Name="LetterDetailsHeader" Style="{StaticResource SectionTitle}" Text="Qo'shimcha"/>
                        <StackPanel x:Name="LetterDetailsPanel"/>
                    </StackPanel>
                </ContentControl>

                <!-- FON -->
                <ContentControl x:Name="BackgroundPage" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="Fon turi"/>
                        <ComboBox x:Name="BackgroundCombo" Style="{StaticResource Select}" SelectionChanged="BackgroundCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel x:Name="PatternPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Gul"/>
                            <ComboBox x:Name="PatternCombo" Style="{StaticResource Select}" MaxDropDownHeight="420"
                                      SelectionChanged="PatternCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="40" Height="26" CornerRadius="6" ClipToBounds="True" Margin="0,0,8,0">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="LightingPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Fonning qayeri yonadi"/>
                            <ComboBox x:Name="BackgroundLightCombo" Style="{StaticResource Select}" DisplayMemberPath="Name" SelectionChanged="Setting_Changed"/>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Rangi"/>
                            <Button x:Name="BackgroundButton" Grid.Column="1" Tag="Background" Style="{StaticResource Swatch}" Width="32" Height="32"
                                    Margin="0,3,6,3" ToolTip="Rang tanlash" Click="ColorButton_Click"/>
                            <TextBox x:Name="BackgroundHex" Grid.Column="2" Tag="Background" TextChanged="Hex_TextChanged"/>
                            <Button Grid.Column="3" Tag="Background" Style="{StaticResource PipetteButton}" Click="Pipette_Click"/>
                            <WrapPanel x:Name="BackgroundSwatches" Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </Grid>

                        <CheckBox x:Name="EngravedBorderCheck" Content="Chetida o'yilgan chiziq" Visibility="Collapsed"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="O'lchami"/>
                        <CheckBox x:Name="AutoSizeCheck" IsChecked="True" Content="Logoga qarab avtomatik"
                                  Checked="AutoSize_Changed" Unchecked="AutoSize_Changed"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Eni"/>
                                <DockPanel>
                                    <TextBlock x:Name="BackgroundWidthUnit" DockPanel.Dock="Right" Style="{StaticResource Unit}"/>
                                    <TextBox x:Name="BackgroundWidthBox" IsEnabled="False" TextChanged="Setting_Changed"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Hint}" Text="Bo'yi"/>
                                <DockPanel>
                                    <TextBlock x:Name="BackgroundHeightUnit" DockPanel.Dock="Right" Style="{StaticResource Unit}"/>
                                    <TextBox x:Name="BackgroundHeightBox" IsEnabled="False" TextChanged="Setting_Changed"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Logo atrofidagi joy"/>
                            <DockPanel Grid.Column="1">
                                <TextBlock x:Name="MarginUnit" DockPanel.Dock="Right" Style="{StaticResource Unit}"/>
                                <TextBox x:Name="MarginBox" TextChanged="Setting_Changed"/>
                            </DockPanel>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Fon qalinligi"/>
                            <DockPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock x:Name="BackgroundDepthUnit" DockPanel.Dock="Right" Style="{StaticResource Unit}"/>
                                <TextBox x:Name="BackgroundDepthBox" TextChanged="Setting_Changed"/>
                            </DockPanel>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Logo joyi"/>
                            <ComboBox x:Name="AlignCombo" Grid.Row="2" Grid.Column="1" Style="{StaticResource Select}"
                                      DisplayMemberPath="Name" SelectionChanged="Setting_Changed"/>
                        </Grid>

                        <TextBlock x:Name="BackgroundDetailsHeader" Style="{StaticResource SectionTitle}" Text="Qo'shimcha"/>
                        <StackPanel x:Name="BackgroundDetailsPanel"/>
                    </StackPanel>
                </ContentControl>

                <!-- JOYIDA: logo bino rasmi ustida -->
                <ContentControl x:Name="PhotoPage" Style="{StaticResource Card}" Visibility="Collapsed" Focusable="True"
                                FocusVisualStyle="{x:Null}" AllowDrop="True" DragOver="Photo_DragOver" Drop="Photo_Drop">
                    <StackPanel>
                        <Button x:Name="PhotoPickButton" Click="PhotoPickButton_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Height="96" CornerRadius="14" Background="{StaticResource FieldBrush}"
                                            BorderBrush="#C9CDD4" BorderThickness="1.5">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="Bino rasmini tanlang" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBlock Text="yoki Ctrl+V · yoki rasmni shu yerga tashlang" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="PhotoPasteButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Content="Nusxalangan rasmni qo'yish (Ctrl+V)" Click="PhotoPaste_Click"/>

                        <StackPanel x:Name="PhotoInfoPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="42" CornerRadius="10" ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush x:Name="PhotoThumb" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PhotoNameText" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Logoni ko'rinishda suring"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource SmallRoundButton}" Content="&#xE77F;" ToolTip="Nusxalangan rasmni qo'yish (Ctrl+V)" Margin="0,0,6,0"
                                            Click="PhotoPaste_Click"/>
                                    <Button Style="{StaticResource SmallRoundButton}" Content="&#xE70F;" ToolTip="Boshqa rasm" Margin="0,0,6,0"
                                            Click="PhotoPickButton_Click"/>
                                    <Button Style="{StaticResource SmallRoundButton}" Content="&#xE711;" ToolTip="Rasmni olib tashlash"
                                            Click="PhotoClearButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Kattaligi"/>
                                <Slider x:Name="PhotoSizeSlider" Grid.Column="1" Minimum="5" Maximum="100" Value="45" VerticalAlignment="Center"
                                        IsMoveToPointEnabled="True" ValueChanged="PhotoSizeSlider_ValueChanged"/>
                                <TextBlock x:Name="PhotoSizeText" Grid.Column="2" Style="{StaticResource Unit}" HorizontalAlignment="Right" Text="45%"/>
                            </Grid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Tez joylash"/>
                            <WrapPanel>
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Content="Tepaga" Tag="0.28" Click="PhotoPlace_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Content="O'rtaga" Tag="0.5" Click="PhotoPlace_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Content="Pastga" Tag="0.72" Click="PhotoPlace_Click"/>
                            </WrapPanel>
                            <CheckBox x:Name="PhotoDrawCheck" IsChecked="True" Content="Corel'da ham chizish (kunduzi + kechasi)"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Ko'rinishda logoni suring, burchagidagi doiradan tortib kattalashtiring. ChatGPT ham shu joyda real qilib chizadi."/>
                    </StackPanel>
                </ContentControl>

                <!-- CHATGPT -->
                <ContentControl x:Name="AiPage" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="Nimani real qilish"/>
                        <WrapPanel>
                            <RadioButton x:Name="AiFromSelection" Style="{StaticResource Chip}" Tag="&#xE8B3;" Content="Corel'da belgilangan" GroupName="AiSource"
                                         IsChecked="True" Checked="Setting_Changed"/>
                            <RadioButton x:Name="AiFromDrawing" Style="{StaticResource Chip}" Tag="&#xE70F;" Content="Chizilgan dizayn" GroupName="AiSource"
                                         Checked="Setting_Changed"/>
                        </WrapPanel>
                        <TextBlock x:Name="AiSourceHint" Style="{StaticResource Hint}"
                                   Text="Corel'da tayyor dizaynni belgilang — ChatGPT uni real qilib ko'rsatadi."/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="OpenAI API kalit"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox" Margin="0,3,6,3"/>
                            <Button x:Name="SaveKeyButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Saqlash"
                                    Click="SaveKeyButton_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink x:Name="ApiKeyLink" RequestNavigate="Link_RequestNavigate">OpenAI kalit olish →</Hyperlink>
                            </TextBlock>
                            <Button x:Name="CheckKeyButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Tekshirish"
                                    Click="CheckKeyButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="KeyStatusText" Style="{StaticResource Hint}"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Qaysi rasmlar"/>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="AiDayCheck" Style="{StaticResource Chip}" Tag="&#xE706;" Content="Kunduzi" IsChecked="True"/>
                            <ToggleButton x:Name="AiNightCheck" Style="{StaticResource Chip}" Tag="&#xE708;" Content="Kechasi" IsChecked="True"/>
                        </StackPanel>
                        <TextBlock x:Name="AiPhotoText" Style="{StaticResource Hint}"/>

                        <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                                Content="Real rasm yaratish" Click="GenerateButton_Click"/>
                        <Button x:Name="CancelAiButton" Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                Content="Bekor qilish" Click="CancelAiButton_Click"/>
                        <ProgressBar x:Name="AiProgress" Height="4" Margin="0,6,0,0" IsIndeterminate="True" Visibility="Collapsed"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource ChipBrush}" BorderThickness="0"/>
                        <TextBlock x:Name="AiStatusText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>

                        <UniformGrid x:Name="AiResults" Columns="2" Margin="0,8,0,0" Visibility="Collapsed">
                            <StackPanel Margin="0,0,4,0">
                                <Border Height="90" CornerRadius="10" Background="{StaticResource CheckerBrush}">
                                    <Image x:Name="AiDayImage" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Text="Kunduzi" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <Border Height="90" CornerRadius="10" Background="{StaticResource NightBrush}">
                                    <Image x:Name="AiNightImage" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Text="Kechasi" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                        <Button x:Name="OpenFolderButton" Style="{StaticResource SecondaryButton}" Visibility="Collapsed"
                                Content="Rasmlar papkasi" Click="OpenFolderButton_Click"/>

                        <Expander Header="Qo'shimcha">
                            <StackPanel Margin="0,6,0,0">
                                <CheckBox x:Name="AutoSendCheck" Content="Chizilgach o'zi yuborsin"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Model"/>
                                    <ComboBox x:Name="ModelCombo" Grid.Column="1" IsEditable="True" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Sifat"/>
                                    <ComboBox x:Name="QualityCombo" Grid.Row="1" Grid.Column="1" Style="{StaticResource Select}"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Rasm o'lchami"/>
                                    <ComboBox x:Name="SizeCombo" Grid.Row="2" Grid.Column="1" Style="{StaticResource Select}"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Topshiriq matni"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,3" Content="Asl holi"
                                            FontSize="11.5" Click="ResetPromptButton_Click"/>
                                </Grid>
                                <TextBox x:Name="PromptBox" Height="88" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" TextChanged="Setting_Changed"/>
                                <Expander Header="Yuboriladigan to'liq matn">
                                    <TextBox x:Name="FullPromptBox" IsReadOnly="True" TextWrapping="Wrap" Height="180" FontSize="11"
                                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ContentControl>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

    <!-- Faollashtirish: litsenziya kaliti bo'lmasa shu oyna ko'rinadi -->
    <ScrollViewer x:Name="ActivationView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource PanelBrush}">
        <StackPanel Margin="10,14,10,10">
            <StackPanel Margin="6,0,6,10">
                <TextBlock Text="CorelDRAW · tashqi reklama" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Style="{StaticResource Title}" Text="Reklama Maket"/>
                <TextBlock FontSize="12" Margin="1,1,0,0">
                    <Run Text="by" Foreground="{StaticResource MutedBrush}"/>
                    <Run Text="Sunnatilla Designer" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                </TextBlock>
            </StackPanel>
            <ContentControl Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Faollashtirish" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Plagin litsenziya kaliti bilan ishlaydi"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,14,0,4" Text="1. Kompyuter kodingiz"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MachineCodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="14" Margin="0,3,6,3"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Nusxa olish" Click="CopyMachineCode_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Shu kodni kalit olishda yuboring."/>

                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,12,0,4" Text="2. Litsenziya kaliti"/>
                    <TextBox x:Name="LicenseKeyBox" Height="74" TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top"
                             FontFamily="Consolas" FontSize="12"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Content="Faollashtirish"
                            Click="ActivateButton_Click"/>
                    <TextBlock x:Name="LicenseStatusText" Style="{StaticResource Hint}" Margin="0,8,0,0"/>

                    <TextBlock Margin="0,10,0,0">
                        <Hyperlink x:Name="LicenseSiteLink" RequestNavigate="Link_RequestNavigate">Kalit olish → sunnatilla-designer.uz</Hyperlink>
                    </TextBlock>
                    <Button x:Name="CancelActivationButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Content="Orqaga" Visibility="Collapsed" Click="CancelActivation_Click"/>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
