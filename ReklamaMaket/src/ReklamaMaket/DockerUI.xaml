<UserControl x:Class="ReklamaMaket.DockerUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260"
             FontFamily="Segoe UI"
             FontSize="12"
             Unloaded="DockerUI_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource PanelBrush}">

        <!-- Sarlavha -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="12,8">
            <StackPanel>
                <TextBlock Text="REKLAMA MAKET" Foreground="White" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Logoni tashqi reklama konstruksiyasida ko'rsatish"
                           Foreground="#D6E4FF" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Pastki tugmalar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="8,6,8,8">
            <StackPanel>
                <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}"
                        Content="CORELDA MAKET YARATISH" Click="CreateButton_Click"/>
                <Button x:Name="ExportViewsButton" Style="{StaticResource SecondaryButton}"
                        Content="3D ko'rinishlarni Corelga qo'shish" Click="ExportViewsButton_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="2,4,2,0"/>
            </StackPanel>
        </Border>

        <!-- Ko'rinish: har doim yuqorida turadi, sozlamalar pastda aylantiriladi -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="8,8,8,0">
            <StackPanel>
                <TabControl x:Name="ViewTabs" BorderThickness="0" Padding="0,6,0,0" Background="Transparent">
                    <TabItem Header="3D ko'rinish">
                        <StackPanel>
                            <Border x:Name="ViewHost" Height="210" CornerRadius="4" ClipToBounds="True" Background="#DCEBF7"
                                    Cursor="SizeAll" ToolTip="Sichqoncha bilan aylantiring, g'ildirak — yaqinlashtirish"
                                    MouseLeftButtonDown="ViewHost_MouseLeftButtonDown"
                                    MouseMove="ViewHost_MouseMove"
                                    MouseLeftButtonUp="ViewHost_MouseLeftButtonUp"
                                    MouseWheel="ViewHost_MouseWheel"
                                    SizeChanged="ViewHost_SizeChanged">
                                <Viewport3D x:Name="Viewport" ClipToBounds="True">
                                    <ModelVisual3D x:Name="LightsVisual"/>
                                    <ModelVisual3D x:Name="SceneVisual"/>
                                </Viewport3D>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,6,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="◀ Chapdan" Margin="0,0,3,0" Click="ViewLeft_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Old" Margin="3,0" Click="ViewFront_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="O'ngdan ▶" Margin="3,0,0,0" Click="ViewRight_Click"/>
                            </UniformGrid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Burilish"/>
                                <Slider x:Name="YawSlider" Grid.Column="1" Minimum="-80" Maximum="80" Value="-25"
                                        VerticalAlignment="Center" ValueChanged="YawSlider_ValueChanged"/>
                                <TextBlock x:Name="YawValueText" Grid.Column="2" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" TextAlignment="Right"/>

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Qiyalik"/>
                                <Slider x:Name="PitchSlider" Grid.Row="1" Grid.Column="1" Minimum="-30" Maximum="45" Value="6"
                                        VerticalAlignment="Center" ValueChanged="PitchSlider_ValueChanged"/>
                                <TextBlock x:Name="PitchValueText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>

                            <CheckBox x:Name="NightCheck" Content="Kechasi (yoritilgan holda)"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Old tomoni (2D)">
                        <Border Height="210" Background="{StaticResource CheckerBrush}" CornerRadius="4" Padding="8">
                            <Image x:Name="FacePreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </TabItem>
                </TabControl>
                <TextBlock x:Name="SizeInfoText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">

                <!-- 1. Logo -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="1. LOGO"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" Background="{StaticResource CheckerBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Image x:Name="LogoImage" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LogoInfoText" Text="Logo tanlanmagan" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}"/>
                                <Button x:Name="CaptureButton" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0"
                                        Content="Tanlangan logoni olish" Click="CaptureButton_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Asl logo o'zgarmaydi — maketga uning nusxasi qo'yiladi."/>
                    </StackPanel>
                </Border>

                <!-- 2. Dizayn turi -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="2. DIZAYN TURI"/>
                        <ComboBox x:Name="DesignCombo" SelectionChanged="DesignCombo_SelectionChanged"/>
                        <TextBlock x:Name="DesignDescription" Style="{StaticResource Hint}" Margin="0,4,0,8"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Tayyor o'lcham"/>
                        <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <!-- 3. O'lchamlar -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="3. O'LCHAMLAR"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Eni"/>
                            <TextBox x:Name="WidthBox" Grid.Column="1" TextChanged="Size_Changed"/>
                            <TextBlock x:Name="WidthUnitText" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Bo'yi"/>
                            <TextBox x:Name="HeightBox" Grid.Row="1" Grid.Column="1" TextChanged="Size_Changed"/>
                            <TextBlock x:Name="HeightUnitText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Qalinligi"/>
                            <TextBox x:Name="DepthBox" Grid.Row="2" Grid.Column="1" TextChanged="Size_Changed"/>
                            <TextBlock x:Name="DepthUnitText" Grid.Row="2" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Yerdan balandligi"/>
                            <TextBox x:Name="ElevationBox" Grid.Row="3" Grid.Column="1" TextChanged="Size_Changed"/>
                            <TextBlock x:Name="ElevationUnitText" Grid.Row="3" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Birlik"/>
                                <ComboBox x:Name="UnitCombo" SelectionChanged="UnitCombo_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Corelda masshtab"/>
                                <ComboBox x:Name="ScaleCombo" ItemStringFormat="1:{0}" SelectionChanged="Setting_Changed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Logo joylashuvi -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="4. LOGO JOYLASHUVI"/>
                        <ComboBox x:Name="AlignCombo" DisplayMemberPath="Name" SelectionChanged="Setting_Changed"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Chetdan joy"/>
                            <Slider x:Name="MarginSlider" Grid.Column="1" Minimum="0" Maximum="40" Value="8"
                                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="Setting_Changed"/>
                            <TextBlock x:Name="MarginValueText" Grid.Column="2" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" TextAlignment="Right"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Logo hajmi"/>
                            <Slider x:Name="LogoSizeSlider" Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="100" Value="100"
                                    VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="Setting_Changed"/>
                            <TextBlock x:Name="LogoSizeValueText" Grid.Row="1" Grid.Column="2" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. Ranglar -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="5. RANGLAR"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Fon"/>
                            <Button x:Name="BackgroundButton" Grid.Column="1" Style="{StaticResource Swatch}" Width="28"
                                    Margin="0,2,6,2" ToolTip="Fon rangini tanlash" Click="BackgroundButton_Click"/>
                            <TextBox x:Name="BackgroundHex" Grid.Column="2" HorizontalContentAlignment="Left"
                                     TextChanged="BackgroundHex_TextChanged"/>

                            <WrapPanel x:Name="BackgroundSwatches" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,2"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Karkas"/>
                            <Button x:Name="FrameButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource Swatch}" Width="28"
                                    Margin="0,2,6,2" ToolTip="Karkas / profil rangini tanlash" Click="FrameButton_Click"/>
                            <TextBox x:Name="FrameHex" Grid.Row="2" Grid.Column="2" HorizontalContentAlignment="Left"
                                     TextChanged="FrameHex_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 6. Qo'shimcha -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="6. QO'SHIMCHA"/>
                        <CheckBox x:Name="EnvironmentCheck" IsChecked="True" Content="Atrof-muhit (devor, yer, osmon)"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="PersonCheck" IsChecked="True" Content="Odam siluyeti (masshtab uchun, 1.75 m)"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="DimensionsCheck" IsChecked="True" Content="O'lcham chiziqlari"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="NewPageCheck" IsChecked="True" Content="Yangi sahifada yaratish"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
