{$DOMAIN} {
	encode gzip
	request_body {
		max_size 2GB
	}
	header {
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy app:8000
}

# www.domen → domen (WWW_DOMAIN berilmasa, bu blok ichki 8082-portda jim turadi)
{$WWW_DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
