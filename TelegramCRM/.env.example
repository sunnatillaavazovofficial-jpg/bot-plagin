# ===== TelegramCRM sozlamalari =====
# Bu faylni .env nomi bilan nusxalang va to'ldiring:  cp .env.example .env

# Uzun tasodifiy maxfiy kalit. Yaratish:  openssl rand -hex 32
# DIQQAT: keyin o'zgartirsangiz, ulangan akkauntlarni qayta ulashga to'g'ri keladi.
SECRET_KEY=

# Birinchi ishga tushishda yaratiladigan admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# my.telegram.org -> API development tools dan olinadi
TG_API_ID=
TG_API_HASH=

# Eslatma boti tokeni (@BotFather). Bo'sh qolsa eslatmalar o'chiq.
BOT_TOKEN=

# Sizning shaxsiy Telegram ID raqamingiz (ixtiyoriy). Yozilsa admin botga oldindan bog'lanadi:
# eslatmalar va botdan kassaga yozish darrov ishlaydi. ID'ni @userinfobot dan bilish mumkin.
ADMIN_TG_ID=

# Saytning domeni (masalan media-max.net). Domen bo'lmasa bo'sh qoldiring.
DOMAIN=
# www bilan kirilganda asosiy domenga yo'naltirish (masalan www.media-max.net). Ixtiyoriy.
WWW_DOMAIN=

# Bosh sahifa uchun tayyor kompaniya matni (backend/app/presets/<nom>.json). Masalan: media-max
# Faqat bo'sh maydonlarni to'ldiradi; keyin Sozlamalar → «Ochiq sahifa» da tahrirlanadi.
SITE_PRESET=

# Saytning to'liq manzili (https bilan). Yozilsa — botdagi «CRM» tugmasi saytni Telegram ichida ochadi (Mini App)
PUBLIC_URL=

# HTTPS (domen) bo'lsa 1, faqat http bo'lsa 0
COOKIE_SECURE=1

TIMEZONE=Asia/Tashkent

# 1 — sinov rejimi: Telegram'ga ulanmaydi, demo ma'lumotlar bilan ishlaydi
TG_FAKE=0

# caddy — sayt o'zining Caddy'si bilan ochiladi (80/443-port bo'sh bo'lganda).
# Bo'sh — serverdagi mavjud nginx/apache orqali ochiladi (install.sh o'zi aniqlaydi).
COMPOSE_PROFILES=caddy
# CRM'ning ichki porti (faqat serverning ichidan ochiq)
APP_PORT=8181
